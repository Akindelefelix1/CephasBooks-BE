generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  ACCOUNTANT
  APPROVER
  MEMBER
  AUDITOR
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

enum BankAccountType {
  CURRENT
  SAVINGS
  CASH
  CREDIT_CARD
  OTHER
}

enum BankTransactionType {
  MONEY_IN
  MONEY_OUT
}

enum ReconciliationStatus {
  UNRECONCILED
  RECONCILED
  EXCLUDED
}

enum SalesDocumentStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
  CONVERTED
  VOID
}

model User {
  id                        String       @id @default(uuid()) @db.Uuid
  email                     String       @unique
  passwordHash              String
  firstName                 String?
  lastName                  String?
  isActive                  Boolean      @default(true)
  verifiedAt                DateTime?
  verificationCodeHash      String?
  verificationCodeExpiresAt DateTime?
  verificationCodeSentAt    DateTime?
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt
  memberships               Membership[]
  sessions                  Session[]
  auditLogs                 AuditLog[]
}

model Organization {
  id                    String       @id @default(uuid()) @db.Uuid
  name                  String
  slug                  String       @unique
  baseCurrency          String       @default("NGN") @db.Char(3)
  countryCode           String       @default("NG") @db.Char(2)
  onboardingData        Json         @default("{}")
  onboardingStep        Int          @default(0)
  onboardingCompletedAt DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  memberships           Membership[]
  customers             Customer[]
  invoices              Invoice[]
  auditLogs             AuditLog[]
  bankAccounts          BankAccount[]
  bankTransactions      BankTransaction[]
  quotations            Quotation[]
  payments              PaymentReceived[]
  creditNotes           CreditNote[]
}

model Membership {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @db.Uuid
  organizationId String       @db.Uuid
  role           Role         @default(MEMBER)
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Customer {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  displayName    String
  companyName    String?
  email          String?
  phone          String?
  taxId          String?
  billingAddress String?
  notes          String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invoices       Invoice[]
  quotations     Quotation[]
  payments       PaymentReceived[]
  creditNotes    CreditNote[]

  @@unique([organizationId, email])
  @@index([organizationId, displayName])
}

model Invoice {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  customerId     String        @db.Uuid
  number         String
  status         InvoiceStatus @default(DRAFT)
  currency       String        @default("NGN") @db.Char(3)
  issueDate      DateTime      @db.Date
  dueDate        DateTime      @db.Date
  subtotal       Decimal       @db.Decimal(19, 4)
  taxTotal       Decimal       @default(0) @db.Decimal(19, 4)
  total          Decimal       @db.Decimal(19, 4)
  paidAmount     Decimal       @default(0) @db.Decimal(19, 4)
  creditedAmount Decimal       @default(0) @db.Decimal(19, 4)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer       Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items          InvoiceItem[]
  payments       PaymentReceived[]
  creditNotes    CreditNote[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([customerId])
}

model Quotation {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  customerId String @db.Uuid
  number String
  status SalesDocumentStatus @default(DRAFT)
  currency String @default("NGN") @db.Char(3)
  issueDate DateTime @db.Date
  expiryDate DateTime @db.Date
  subtotal Decimal @db.Decimal(19,4)
  taxTotal Decimal @default(0) @db.Decimal(19,4)
  total Decimal @db.Decimal(19,4)
  items Json
  notes String?
  convertedInvoiceId String? @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields:[organizationId], references:[id], onDelete:Restrict)
  customer Customer @relation(fields:[customerId], references:[id], onDelete:Restrict)
  @@unique([organizationId, number])
  @@index([organizationId,status])
}

model PaymentReceived {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  customerId String @db.Uuid
  invoiceId String @db.Uuid
  reference String
  amount Decimal @db.Decimal(19,4)
  currency String @default("NGN") @db.Char(3)
  paymentDate DateTime @db.Date
  method String
  notes String?
  createdAt DateTime @default(now())
  organization Organization @relation(fields:[organizationId], references:[id], onDelete:Restrict)
  customer Customer @relation(fields:[customerId], references:[id], onDelete:Restrict)
  invoice Invoice @relation(fields:[invoiceId], references:[id], onDelete:Restrict)
  @@unique([organizationId, reference])
  @@index([organizationId,paymentDate])
}

model CreditNote {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  customerId String @db.Uuid
  invoiceId String @db.Uuid
  number String
  amount Decimal @db.Decimal(19,4)
  currency String @default("NGN") @db.Char(3)
  issueDate DateTime @db.Date
  reason String
  isVoid Boolean @default(false)
  createdAt DateTime @default(now())
  organization Organization @relation(fields:[organizationId], references:[id], onDelete:Restrict)
  customer Customer @relation(fields:[customerId], references:[id], onDelete:Restrict)
  invoice Invoice @relation(fields:[invoiceId], references:[id], onDelete:Restrict)
  @@unique([organizationId, number])
  @@index([organizationId,issueDate])
}

model InvoiceItem {
  id          String  @id @default(uuid()) @db.Uuid
  invoiceId   String  @db.Uuid
  description String
  quantity    Decimal @db.Decimal(19, 4)
  unitPrice   Decimal @db.Decimal(19, 4)
  taxRate     Decimal @default(0) @db.Decimal(7, 4)
  lineTotal   Decimal @db.Decimal(19, 4)
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model AuditLog {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String?       @db.Uuid
  actorId        String?       @db.Uuid
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime      @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor          User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([actorId, createdAt])
}

model BankAccount {
  id                 String            @id @default(uuid()) @db.Uuid
  organizationId     String            @db.Uuid
  name               String
  bankName           String?
  accountType        BankAccountType
  accountNumberLast4 String?
  currency           String            @default("NGN") @db.Char(3)
  openingBalance     Decimal           @default(0) @db.Decimal(19, 4)
  currentBalance     Decimal           @default(0) @db.Decimal(19, 4)
  isActive           Boolean           @default(true)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  transactions       BankTransaction[]

  @@index([organizationId, isActive])
}

model BankTransaction {
  id                   String               @id @default(uuid()) @db.Uuid
  organizationId       String               @db.Uuid
  bankAccountId        String               @db.Uuid
  transactionDate      DateTime             @db.Date
  description          String
  reference            String?
  type                 BankTransactionType
  amount               Decimal              @db.Decimal(19, 4)
  balanceAfter         Decimal              @db.Decimal(19, 4)
  reconciliationStatus ReconciliationStatus @default(UNRECONCILED)
  reconciledAt         DateTime?
  notes                String?
  importFingerprint    String?
  transferGroupId      String?              @db.Uuid
  reversedAt           DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  organization         Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  bankAccount          BankAccount          @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)

  @@index([organizationId, transactionDate])
  @@index([bankAccountId, reconciliationStatus])
  @@unique([organizationId, bankAccountId, importFingerprint])
  @@index([transferGroupId])
}
