generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  ACCOUNTANT
  APPROVER
  MEMBER
  AUDITOR
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

enum BankAccountType {
  CURRENT
  SAVINGS
  CASH
  CREDIT_CARD
  OTHER
}

enum BankTransactionType {
  MONEY_IN
  MONEY_OUT
}

enum ReconciliationStatus {
  UNRECONCILED
  RECONCILED
  EXCLUDED
}

enum SalesDocumentStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
  CONVERTED
  VOID
}

enum PurchaseRequestStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  CONVERTED
}

enum PurchaseOrderStatus {
  DRAFT
  ISSUED
  PARTIALLY_RECEIVED
  RECEIVED
  BILLED
  CANCELLED
}

enum BillStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
  VOID
}

enum LedgerAccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum JournalStatus {
  DRAFT
  POSTED
  REVERSED
}

enum FinanceRecordKind {
  ASSET
  BUDGET
  TAX
  PAYROLL
}

enum ItemType {
  PRODUCT
  SERVICE
}

enum StockMovementType {
  RECEIPT
  ISSUE
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
}

enum AdjustmentStatus {
  DRAFT
  APPROVED
  VOID
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum InsightReportType {
  EXECUTIVE
  PROFIT_LOSS
  CASH_FLOW
  RECEIVABLES
  PAYABLES
  INVENTORY
  PROJECTS
}

enum SyncDirection {
  IMPORT
  EXPORT
  TWO_WAY
}

enum SyncStatus {
  ACTIVE
  PAUSED
  ERROR
}

model User {
  id                        String       @id @default(uuid()) @db.Uuid
  email                     String       @unique
  passwordHash              String
  firstName                 String?
  lastName                  String?
  isActive                  Boolean      @default(true)
  verifiedAt                DateTime?
  verificationCodeHash      String?
  verificationCodeExpiresAt DateTime?
  verificationCodeSentAt    DateTime?
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt
  memberships               Membership[]
  sessions                  Session[]
  auditLogs                 AuditLog[]
}

model Organization {
  id                    String            @id @default(uuid()) @db.Uuid
  name                  String
  slug                  String            @unique
  baseCurrency          String            @default("NGN") @db.Char(3)
  countryCode           String            @default("NG") @db.Char(2)
  onboardingData        Json              @default("{}")
  onboardingStep        Int               @default(0)
  onboardingCompletedAt DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  memberships           Membership[]
  customers             Customer[]
  invoices              Invoice[]
  auditLogs             AuditLog[]
  bankAccounts          BankAccount[]
  bankTransactions      BankTransaction[]
  quotations            Quotation[]
  payments              PaymentReceived[]
  creditNotes           CreditNote[]
  suppliers             Supplier[]
  purchaseRequests      PurchaseRequest[]
  purchaseOrders        PurchaseOrder[]
  bills                 Bill[]
  supplierPayments      SupplierPayment[]
  expenses              Expense[]
  ledgerAccounts        LedgerAccount[]
  journals              Journal[]
  financeRecords        FinanceRecord[]
  products              Product[]
  warehouses            Warehouse[]
  stockMovements        StockMovement[]
  stockAdjustments      StockAdjustment[]
  projects              Project[]
  savedReports          SavedReport[]
  aiInsights            AiInsight[]
  workbookConnections   WorkbookConnection[]
}

model SavedReport {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  name           String
  description    String?
  type           InsightReportType @default(EXECUTIVE)
  dateFrom       DateTime?         @db.Date
  dateTo         DateTime?         @db.Date
  isArchived     Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@index([organizationId, isArchived])
}

model AiInsight {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  question       String
  answer         String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

model WorkbookConnection {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  name           String
  dataSource     String
  fileName       String?
  direction      SyncDirection @default(EXPORT)
  status         SyncStatus    @default(ACTIVE)
  rowsSynced     Int           @default(0)
  lastSyncedAt   DateTime?
  errorMessage   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@index([organizationId, status])
}

model Product {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  sku            String
  name           String
  type           ItemType          @default(PRODUCT)
  category       String?
  description    String?
  unit           String            @default("unit")
  salePrice      Decimal           @default(0) @db.Decimal(19, 4)
  costPrice      Decimal           @default(0) @db.Decimal(19, 4)
  taxRate        Decimal           @default(0) @db.Decimal(7, 4)
  reorderLevel   Decimal           @default(0) @db.Decimal(19, 4)
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  movements      StockMovement[]
  adjustments    StockAdjustment[]

  @@unique([organizationId, sku])
  @@index([organizationId, type, isActive])
}

model Warehouse {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  code           String
  name           String
  address        String?
  manager        String?
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  movements      StockMovement[]
  adjustments    StockAdjustment[]

  @@unique([organizationId, code])
  @@index([organizationId, isActive])
}

model StockMovement {
  id              String            @id @default(uuid()) @db.Uuid
  organizationId  String            @db.Uuid
  productId       String            @db.Uuid
  warehouseId     String            @db.Uuid
  type            StockMovementType
  quantity        Decimal           @db.Decimal(19, 4)
  unitCost        Decimal           @default(0) @db.Decimal(19, 4)
  movementDate    DateTime          @db.Date
  reference       String
  transferGroupId String?           @db.Uuid
  notes           String?
  createdAt       DateTime          @default(now())
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  product         Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse       Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@unique([organizationId, reference])
  @@index([organizationId, movementDate])
  @@index([productId, warehouseId])
  @@index([transferGroupId])
}

model StockAdjustment {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  productId      String           @db.Uuid
  warehouseId    String           @db.Uuid
  reference      String
  adjustmentDate DateTime         @db.Date
  quantityDelta  Decimal          @db.Decimal(19, 4)
  unitCost       Decimal          @default(0) @db.Decimal(19, 4)
  reason         String
  status         AdjustmentStatus @default(DRAFT)
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  product        Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse      Warehouse        @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@unique([organizationId, reference])
  @@index([organizationId, status, adjustmentDate])
}

model Project {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  code           String
  name           String
  client         String?
  owner          String
  startDate      DateTime      @db.Date
  endDate        DateTime?     @db.Date
  budget         Decimal       @default(0) @db.Decimal(19, 4)
  actualCost     Decimal       @default(0) @db.Decimal(19, 4)
  revenue        Decimal       @default(0) @db.Decimal(19, 4)
  status         ProjectStatus @default(PLANNED)
  description    String?
  tasks          Json          @default("[]")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, code])
  @@index([organizationId, status])
}

model Membership {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @db.Uuid
  organizationId String       @db.Uuid
  role           Role         @default(MEMBER)
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Customer {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  displayName    String
  companyName    String?
  email          String?
  phone          String?
  taxId          String?
  billingAddress String?
  notes          String?
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invoices       Invoice[]
  quotations     Quotation[]
  payments       PaymentReceived[]
  creditNotes    CreditNote[]

  @@unique([organizationId, email])
  @@index([organizationId, displayName])
}

model Invoice {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  customerId     String            @db.Uuid
  number         String
  status         InvoiceStatus     @default(DRAFT)
  currency       String            @default("NGN") @db.Char(3)
  issueDate      DateTime          @db.Date
  dueDate        DateTime          @db.Date
  subtotal       Decimal           @db.Decimal(19, 4)
  taxTotal       Decimal           @default(0) @db.Decimal(19, 4)
  total          Decimal           @db.Decimal(19, 4)
  paidAmount     Decimal           @default(0) @db.Decimal(19, 4)
  creditedAmount Decimal           @default(0) @db.Decimal(19, 4)
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer       Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items          InvoiceItem[]
  payments       PaymentReceived[]
  creditNotes    CreditNote[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([customerId])
}

model Quotation {
  id                 String              @id @default(uuid()) @db.Uuid
  organizationId     String              @db.Uuid
  customerId         String              @db.Uuid
  number             String
  status             SalesDocumentStatus @default(DRAFT)
  currency           String              @default("NGN") @db.Char(3)
  issueDate          DateTime            @db.Date
  expiryDate         DateTime            @db.Date
  subtotal           Decimal             @db.Decimal(19, 4)
  taxTotal           Decimal             @default(0) @db.Decimal(19, 4)
  total              Decimal             @db.Decimal(19, 4)
  items              Json
  notes              String?
  convertedInvoiceId String?             @db.Uuid
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer           Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@unique([organizationId, number])
  @@index([organizationId, status])
}

model PaymentReceived {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  customerId     String       @db.Uuid
  invoiceId      String       @db.Uuid
  reference      String
  amount         Decimal      @db.Decimal(19, 4)
  currency       String       @default("NGN") @db.Char(3)
  paymentDate    DateTime     @db.Date
  method         String
  notes          String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  invoice        Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@unique([organizationId, reference])
  @@index([organizationId, paymentDate])
}

model CreditNote {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  customerId     String       @db.Uuid
  invoiceId      String       @db.Uuid
  number         String
  amount         Decimal      @db.Decimal(19, 4)
  currency       String       @default("NGN") @db.Char(3)
  issueDate      DateTime     @db.Date
  reason         String
  isVoid         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  invoice        Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@unique([organizationId, number])
  @@index([organizationId, issueDate])
}

model InvoiceItem {
  id          String  @id @default(uuid()) @db.Uuid
  invoiceId   String  @db.Uuid
  description String
  quantity    Decimal @db.Decimal(19, 4)
  unitPrice   Decimal @db.Decimal(19, 4)
  taxRate     Decimal @default(0) @db.Decimal(7, 4)
  lineTotal   Decimal @db.Decimal(19, 4)
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model AuditLog {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String?       @db.Uuid
  actorId        String?       @db.Uuid
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime      @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor          User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([actorId, createdAt])
}

model BankAccount {
  id                 String            @id @default(uuid()) @db.Uuid
  organizationId     String            @db.Uuid
  name               String
  bankName           String?
  accountType        BankAccountType
  accountNumberLast4 String?
  currency           String            @default("NGN") @db.Char(3)
  openingBalance     Decimal           @default(0) @db.Decimal(19, 4)
  currentBalance     Decimal           @default(0) @db.Decimal(19, 4)
  isActive           Boolean           @default(true)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  transactions       BankTransaction[]

  @@index([organizationId, isActive])
}

model BankTransaction {
  id                   String               @id @default(uuid()) @db.Uuid
  organizationId       String               @db.Uuid
  bankAccountId        String               @db.Uuid
  transactionDate      DateTime             @db.Date
  description          String
  reference            String?
  type                 BankTransactionType
  amount               Decimal              @db.Decimal(19, 4)
  balanceAfter         Decimal              @db.Decimal(19, 4)
  reconciliationStatus ReconciliationStatus @default(UNRECONCILED)
  reconciledAt         DateTime?
  notes                String?
  importFingerprint    String?
  transferGroupId      String?              @db.Uuid
  sourceType           String?
  sourceId             String?              @db.Uuid
  reversedAt           DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  organization         Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  bankAccount          BankAccount          @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)

  @@unique([organizationId, bankAccountId, importFingerprint])
  @@index([organizationId, transactionDate])
  @@index([bankAccountId, reconciliationStatus])
  @@index([transferGroupId])
  @@index([organizationId, sourceType, sourceId])
}

model Supplier {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  displayName    String
  companyName    String?
  email          String?
  phone          String?
  taxId          String?
  bankDetails    String?
  paymentTerms   String?
  address        String?
  notes          String?
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  orders         PurchaseOrder[]
  bills          Bill[]
  payments       SupplierPayment[]
  expenses       Expense[]

  @@unique([organizationId, email])
  @@index([organizationId, displayName])
}

model PurchaseRequest {
  id             String                @id @default(uuid()) @db.Uuid
  organizationId String                @db.Uuid
  number         String
  requestedBy    String
  requiredDate   DateTime              @db.Date
  status         PurchaseRequestStatus @default(DRAFT)
  currency       String                @default("NGN") @db.Char(3)
  items          Json
  total          Decimal               @db.Decimal(19, 4)
  notes          String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  purchaseOrder  PurchaseOrder?

  @@unique([organizationId, number])
  @@index([organizationId, status])
}

model PurchaseOrder {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @db.Uuid
  supplierId     String              @db.Uuid
  requestId      String?             @unique @db.Uuid
  number         String
  orderDate      DateTime            @db.Date
  deliveryDate   DateTime            @db.Date
  status         PurchaseOrderStatus @default(DRAFT)
  currency       String              @default("NGN") @db.Char(3)
  items          Json
  subtotal       Decimal             @db.Decimal(19, 4)
  taxTotal       Decimal             @default(0) @db.Decimal(19, 4)
  total          Decimal             @db.Decimal(19, 4)
  notes          String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  supplier       Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  request        PurchaseRequest?    @relation(fields: [requestId], references: [id], onDelete: Restrict)
  bills          Bill[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
}

model Bill {
  id              String            @id @default(uuid()) @db.Uuid
  organizationId  String            @db.Uuid
  supplierId      String            @db.Uuid
  purchaseOrderId String?           @db.Uuid
  number          String
  issueDate       DateTime          @db.Date
  dueDate         DateTime          @db.Date
  status          BillStatus        @default(DRAFT)
  currency        String            @default("NGN") @db.Char(3)
  items           Json
  subtotal        Decimal           @db.Decimal(19, 4)
  taxTotal        Decimal           @default(0) @db.Decimal(19, 4)
  total           Decimal           @db.Decimal(19, 4)
  paidAmount      Decimal           @default(0) @db.Decimal(19, 4)
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  supplier        Supplier          @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseOrder   PurchaseOrder?    @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  payments        SupplierPayment[]

  @@unique([organizationId, number])
  @@index([organizationId, status, dueDate])
}

model SupplierPayment {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  supplierId     String       @db.Uuid
  billId         String       @db.Uuid
  bankAccountId  String?      @db.Uuid
  reference      String
  paymentDate    DateTime     @db.Date
  amount         Decimal      @db.Decimal(19, 4)
  currency       String       @default("NGN") @db.Char(3)
  method         String
  notes          String?
  reversedAt     DateTime?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  supplier       Supplier     @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  bill           Bill         @relation(fields: [billId], references: [id], onDelete: Restrict)

  @@unique([organizationId, reference])
  @@index([organizationId, paymentDate])
}

model Expense {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  supplierId     String?       @db.Uuid
  bankAccountId  String?       @db.Uuid
  reference      String
  expenseDate    DateTime      @db.Date
  merchant       String
  category       String
  amount         Decimal       @db.Decimal(19, 4)
  taxAmount      Decimal       @default(0) @db.Decimal(19, 4)
  currency       String        @default("NGN") @db.Char(3)
  status         ExpenseStatus @default(PENDING)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  supplier       Supplier?     @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  @@unique([organizationId, reference])
  @@index([organizationId, status, expenseDate])
}

model LedgerAccount {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  code           String
  name           String
  type           LedgerAccountType
  description    String?
  isActive       Boolean           @default(true)
  isSystem       Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, code])
  @@index([organizationId, type, isActive])
}

model Journal {
  id                String        @id @default(uuid()) @db.Uuid
  organizationId    String        @db.Uuid
  number            String
  journalDate       DateTime      @db.Date
  description       String
  status            JournalStatus @default(DRAFT)
  lines             Json
  total             Decimal       @db.Decimal(19, 4)
  reversedJournalId String?       @db.Uuid
  postedAt          DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  organization      Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, number])
  @@index([organizationId, status, journalDate])
}

model FinanceRecord {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  kind           FinanceRecordKind
  reference      String
  name           String
  startDate      DateTime          @db.Date
  endDate        DateTime?         @db.Date
  amount         Decimal           @db.Decimal(19, 4)
  status         String
  data           Json              @default("{}")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, kind, reference])
  @@index([organizationId, kind, status])
}
